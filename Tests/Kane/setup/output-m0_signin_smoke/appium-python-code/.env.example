# ── Run target ──
# 'local' drives an Appium server on this machine; 'cloud' drives LT.
TESTMU_RUN_TARGET=local

# ── LT Credentials (required when TESTMU_RUN_TARGET=cloud) ──
LT_USERNAME=
LT_ACCESS_KEY=

# ── Smart Mode (on by default; set to 0 to disable vision/heal) ──
TESTMU_SMART=1

# ── AI API (vision + assertions) ──
TESTMU_AI_API_HOST=https://kaneai-api.lambdatest.com/v16-server
